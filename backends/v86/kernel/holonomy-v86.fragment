# Holonomy v86 bridge kernel fragment.
# Merge this on top of i386_defconfig; every bridge dependency stays built-in
# because the supervisor initrd intentionally carries no kernel modules.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXPERT=y
# CONFIG_MTRR is not set
# CONFIG_X86_PAT is not set

CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_TUN=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y

CONFIG_FUSE_FS=y
CONFIG_SECURITY=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
